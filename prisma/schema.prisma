// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model KnowledgeItem {
  id        String   @id @default(uuid())
  shop      String
  type      String   // "PRODUCT", "POLICY"
  sourceId  String   // Shopify GID
  content   String   // Text content for AI context
  metadata  String?  // JSON stringified metadata (price, handle, etc.)
  updatedAt DateTime @updatedAt

  @@index([shop, type])
}

model AppSettings {
  shop        String   @id
  botName     String   @default("AI Assistant")
  botPersona  String   @default("A helpful shopping assistant.")
  demoMode    Boolean  @default(false)
  lastSynced  DateTime?
  updatedAt   DateTime @updatedAt
}
model Lead {
  id        String   @id @default(uuid())
  shop      String
  email     String
  context   String?  // Optional context about what they were asking
  createdAt DateTime @default(now())

  @@index([shop])
}
