generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model KnowledgeItem {
  id        String   @id @default(uuid())
  shop      String
  type      String
  sourceId  String
  content   String
  metadata  String?
  updatedAt DateTime @updatedAt

  @@index([shop, type])
}

model AppSettings {
  shop       String    @id
  botName    String    @default("AI Assistant")
  botPersona String    @default("A helpful shopping assistant.")
  demoMode   Boolean   @default(false)
  lastSynced DateTime?
  updatedAt  DateTime  @updatedAt
}

model Lead {
  id        String   @id @default(uuid())
  shop      String
  email     String
  context   String?
  createdAt DateTime @default(now())

  @@index([shop])
}

model Quiz {
  id          String          @id @default(uuid())
  shop        String
  title       String
  description String?
  active      Boolean         @default(true)
  questions   QuizQuestion[]
  results     QuizResult[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([shop])
}

model QuizQuestion {
  id          String       @id @default(uuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    String
  type        String       @default("single") // single, multiple, text
  options     Json         // [{ text: string, image?: string, productTags?: string[] }]
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([quizId])
}

model QuizResult {
  id           String   @id @default(uuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  email        String?
  answers      Json     // [{ questionId: string, selectedOptions: string[] }]
  products     Json?    // Recommended product IDs
  createdAt    DateTime @default(now())

  @@index([quizId])
}
